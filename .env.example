# F1 Strategy Analytics - Environment Configuration
# Copy to .env and fill in values

# Database (default: SQLite local file)
DATABASE_URL=sqlite:///data/f1_strategy.db

# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/f1_strategy

# OpenF1 API
OPENF1_BASE_URL=https://api.openf1.org/v1

# Data directories
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed

# Ingestion settings
OPENF1_REQUEST_TIMEOUT=30
OPENF1_MAX_RETRIES=3
OPENF1_RETRY_DELAY=1.0

# Cleaning thresholds
CLEAN_LAP_MAD_THRESHOLD=4.0
CLEAN_LAP_MIN_LAP_NUMBER=2
